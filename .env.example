# Public demo runs without credentials. Use team to open your API diagnostics first.
REALSEE_MODE=demo

# Team mode: fill these in this local file, then restart the dev server.
# Never prefix these names with VITE_. Never paste credentials into a prompt.
REALSEE_APP_KEY=
REALSEE_APP_SECRET=
REALSEE_TEAM_SOURCE=

# Overseas public API gateway for server-side requests.
REALSEE_GATEWAY_BASE_URL=https://app-gateway.realsee.ai

# Optional: backend 4101, Vite 5173. Both listen on 127.0.0.1 only.
# PORT=4101
# VITE_PORT=5173
